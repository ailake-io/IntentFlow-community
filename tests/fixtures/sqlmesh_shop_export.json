  {
   "fqn": "\"shop\".\"shop\".\"revenue_by_country\"",
   "name": "shop.revenue_by_country",
   "kind": "FULL",
   "dialect": "duckdb",
   "sql": "SELECT \"fct_orders\".\"country\" AS \"country\", SUM(\"fct_orders\".\"amount\") AS \"revenue\", COUNT(*) AS \"orders\" FROM \"shop\".\"shop\".\"fct_orders\" AS \"fct_orders\" WHERE \"fct_orders\".\"status\" = 'paid' GROUP BY \"fct_orders\".\"country\"",
   "columns": {
    "country": "TEXT",
    "revenue": "DECIMAL(10, 2)",
    "orders": "BIGINT"
   },
