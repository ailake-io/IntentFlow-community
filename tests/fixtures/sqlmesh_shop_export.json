  {
   "fqn": "\"shop\".\"shop\".\"fct_orders\"",
   "name": "shop.fct_orders",
   "kind": "FULL",
   "dialect": "duckdb",
   "sql": "SELECT \"o\".\"id\" AS \"order_id\", \"o\".\"customer_id\" AS \"customer_id\", \"o\".\"amount\" AS \"amount\", \"o\".\"status\" AS \"status\", \"o\".\"ordered_at\" AS \"ordered_at\", \"c\".\"country\" AS \"country\" FROM \"shop\".\"shop\".\"raw_orders\" AS \"o\" LEFT JOIN \"shop\".\"shop\".\"stg_customers\" AS \"c\" ON \"c\".\"customer_id\" = \"o\".\"customer_id\" WHERE \"o\".\"status\" <> 'cancelled'",
   "columns": {
    "order_id": "INT",
    "customer_id": "INT",
    "amount": "DECIMAL(10, 2)",
    "status": "TEXT",
    "ordered_at": "DATE",
    "country": "TEXT"
   },
